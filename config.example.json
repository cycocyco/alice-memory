{
  "_readme": [
    "把本文件复制为 config.json 再改，config.json 已在 .gitignore 里，不会被提交。",
    "一个 data_dir 只放一个 memories.sqlite3：正文、向量、墓碑、FTS 同库，不再拆两个文件。",
    "优先级：环境变量 > config.local.json > config.json > 内置默认值。",
    "embedding 留空时插件照常工作：自动捕获和手动记忆都正常，召回退化成全文/关键词检索。",
    "想要语义召回就填 url / model，并把 key 写进 DSH_HOME/.env 里 api_key_env 指定的变量名。",
    "url 要任何 OpenAI 兼容的 /v1/embeddings 接口，不限于某一家服务商。",
    "换模型等于全库重嵌；dimensions 变了尤其麻烦，选之前想清楚。"
  ],
  "data_dir": "",
  "scope_id": "default",
  "api_key_env": "EMBEDDING_API_KEY",
  "api_key": "",
  "embedding": {
    "url": "",
    "model": "",
    "dimensions": 1024,
    "timeout_ms": 3500,
    "max_input_chars": 2000,
    "batch": 16
  },
  "search": {
    "query_prefix": "task: question answering | query: ",
    "doc_prefix": "title: none | text: ",
    "min_score": 0.5,
    "vector_weight": 1.0,
    "lexical_weight": 0.35,
    "rrf_k": 60
  },
  "recall": {
    "enabled": true,
    "limit": 3,
    "timeout_ms": 6000,
    "max_chars": 400,
    "labels": {
      "user": "User",
      "assistant": "Assistant"
    }
  },
  "capture": {
    "enabled": true,
    "min_prose": 25,
    "short_keep": 12,
    "long_ok": 40,
    "max_keep": 300,
    "head_keep": 200,
    "tail_keep": 90,
    "daily_cap": 150,
    "embed_retry_minutes": 5
  },
  "memory": {
    "_note": "分层容量是硬约束：只有 hot + warm 常驻内存参与每轮扫描，cold 留在磁盘上按需唤醒。",
    "hot_max": 3000,
    "warm_max": 12000,
    "half_life_days": 45,
    "half_life": { "task": 3, "turn": 45, "preference": 365, "manual": 0 },
    "hot_in": 0.6,
    "hot_out": 0.4,
    "warm_in": 0.3,
    "warm_out": 0.15,
    "reinforce_base": 1.0,
    "reinforce_gain": 0.35,
    "reinforce_cap": 3.0,
    "sweep_hours": 6,
    "archive_after_days": 0,
    "prefer_worker": true
  },
  "redact": true,
  "log_level": "info"
}
